{
  "SmokeTest": {
    "action": "Screencap",
    "filename": "smoke_test",
    "post_delay": 500
  },
  "ScreencapOnly": {
    "action": "Screencap",
    "filename": "manual_screencap"
  },
  "StartGame": {
    "action": "StartApp",
    "package": "com.tencent.jkchess",
    "post_delay": 3000,
    "next": ["LobbyReady_ClearPopups"]
  },
  "StopGame": {
    "action": "StopApp",
    "package": "com.tencent.jkchess"
  },
  "TapKnownPoint": {
    "recognition": "DirectHit",
    "action": "Click",
    "target": [640, 360]
  },

  "LobbyReady": {
    "action": "StartApp",
    "package": "com.tencent.jkchess",
    "post_delay": 3000,
    "next": ["LobbyReady_ClearPopups"]
  },
  "LobbyReady_ClearPopups": {
    "next": ["[JumpBack]Popup_CloseX", "[JumpBack]Popup_ExitCancel"],
    "timeout": 1500,
    "on_error": ["Lobby_Validate"]
  },
  "Lobby_Validate": {
    "next": ["Lobby_LeftMenuVisible"],
    "timeout": 1500,
    "on_error": ["Lobby_Screencap"]
  },
  "Lobby_LeftMenuVisible": {
    "recognition": "TemplateMatch",
    "template": [
      "lobby/nav_event.png",
      "lobby/nav_shop.png",
      "lobby/nav_treasure.png",
      "lobby/nav_codex.png",
      "lobby/nav_summon.png"
    ],
    "threshold": [0.78, 0.78, 0.78, 0.78, 0.78],
    "roi": [0, 120, 180, 450],
    "action": "Screencap",
    "filename": "lobby_ready"
  },
  "Lobby_Screencap": {
    "action": "Screencap",
    "filename": "lobby_ready"
  },

  "ClearPopups": {
    "next": ["[JumpBack]Popup_CloseX", "[JumpBack]Popup_ExitCancel"],
