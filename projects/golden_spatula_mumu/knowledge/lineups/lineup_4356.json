  "traits_summary": "【木灵九五烬】3木灵族2暗星2狙神",
  "recommended_equipment": {
    "note": "保证烬鬼索狂暴之刃与无尽的前提下，再补任意一件物理装。其他保证有重伤与破甲即可，装备不够优先合偷偷给其他五费，偷偷优先布里茨",
    "order_ids": [1001, 1009, 1002, 1003, 1007],
    "order_names": ["暴风之剑", "拳套", "反曲之弓", "无用大棒", "巨人腰带"]
  },
  "augment_recommendations": {
    "ids": [30028, 3008, 30009, 1714, 20213, 3158, 30027, 20584],
    "note": "优先经济海克斯，玩95阵容至少有2经济才会比较顺利。（部分对局三经济亦可，一般不建议，至少需要补一个装备或者战力的）"
  },
  "notes": {
    "early": "运营节奏：2-1 直接拉 4 人口，按棋子定位直接给装备，冲连胜就别省装备2-3 或 2-5 拉 5 人口，围绕三费主 C 体系补充前排或后排3-1 拉 6 人口，只要能稳住连胜，可适当拉人口补战力，短期亏点利息也没关系，中途战力富余时，可以开 3未来战士蹭额外经验或刷新次数",
    "economy": "4杠1/4杠2，根据剩余血量与经济情况与抽牌情况判断是84苟分或者追95上限都可以。如果确定84，不用留经济，保证4费全2的情况再考虑其他；如果血量经济都足够95，小抽几下，保证4阶段能吃30利息以上，出野5杠1/5杠2上9转95，再d空打干。",
    "positioning": "优先吃慎的增幅效果而站位。这套打法的前提是：前中期必须打出6 连胜以上，5 阶段能上 9 人口且经济保留 30 以上，血量也不能太低，至少 30 血以上。如果达不到这些条件，就转下位阵容，用 84 拼多多霞或其他物理 84 阵容苟分",
    "matchup": "95阵容，比较难以成型，基本不会被其他阵容克制"
  },
