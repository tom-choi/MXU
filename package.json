{
  "name": "mxu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare:golden-spatula-mumu": "node scripts/prepare-golden-spatula-mumu.mjs",
    "prepare:golden-spatula-mumu:strict": "node scripts/prepare-golden-spatula-mumu.mjs --strict-maafw",
    "golden:generate-tutorial": "node scripts/golden-spatula-generate-tutorial-pipeline.mjs",
    "golden:generate-tutorial:check": "node scripts/golden-spatula-generate-tutorial-pipeline.mjs --check",
    "golden:red-dot": "node scripts/golden-spatula-run-red-dot.mjs",
    "golden:tutorial": "node scripts/golden-spatula-run-red-dot.mjs --entry BeginnerTutorialFullRun --timeout-ms 600000 --no-strict-patrol-coverage",
    "golden:analyze": "node scripts/golden-spatula-analyze-run.mjs",
    "golden:analyze-recordings": "node scripts/golden-spatula-analyze-recordings.mjs",
    "golden:analyze-video": "node scripts/golden-spatula-analyze-video.mjs",
    "golden:analyze-mmor": "node scripts/golden-spatula-analyze-mmor.mjs",
    "golden:auto-roll": "node scripts/golden-spatula-run-auto-roll-buy.mjs",
    "golden:readiness": "node scripts/golden-spatula-readiness.mjs",
    "golden:audit-automation": "node scripts/golden-spatula-audit-automation.mjs",
    "golden:audit-augment-presence": "python scripts/golden-spatula-audit-augment-presence-video.py --video \"docs/mp4s/金铲铲之战(4).mp4\" --interval-seconds 1 --reuse-frames",
    "golden:test-video-calibration": "node scripts/golden-spatula-test-video-calibration.mjs",
    "golden:test-mmor-calibration": "node scripts/golden-spatula-test-mmor-calibration.mjs",
    "golden:test-ingame-template-match": "node scripts/golden-spatula-test-ingame-template-match.mjs",
    "golden:test-economy-vision": "node scripts/golden-spatula-test-economy-vision.mjs",
    "golden:test-augment-decision": "node scripts/golden-spatula-test-augment-decision.mjs",
    "golden:test-roll-pipeline": "node scripts/golden-spatula-test-roll-pipeline.mjs",
    "golden:test-dynamic-pipeline-graph": "node scripts/golden-spatula-test-dynamic-pipeline-graph.mjs",
    "golden:test-dynamic-runner": "node scripts/golden-spatula-test-dynamic-runner.mjs",
    "golden:test-readiness-runner": "node scripts/golden-spatula-test-readiness-runner.mjs",
    "golden:test-battle-automation": "node scripts/golden-spatula-test-battle-automation.mjs",
    "golden:test-automation-events": "node scripts/golden-spatula-test-automation-events.mjs",
    "golden:test-automation-scenarios": "node scripts/golden-spatula-test-automation-scenarios.mjs",
    "golden:recording-regression": "node scripts/golden-spatula-recording-regression.mjs",
    "golden:test-automation": "pnpm golden:test-video-calibration && pnpm golden:test-mmor-calibration && pnpm golden:recording-regression && pnpm golden:test-ingame-template-match && pnpm golden:test-augment-decision && pnpm golden:test-roll-pipeline && pnpm golden:test-dynamic-pipeline-graph && pnpm golden:test-dynamic-runner && pnpm golden:test-readiness-runner && pnpm golden:test-battle-automation && pnpm golden:test-automation-events && pnpm golden:test-automation-scenarios && pnpm golden:audit-automation && pnpm golden:generate-tutorial:check",
    "golden:crop-assets": "node scripts/golden-spatula-crop-assets.mjs",
    "golden:fetch-knowledge": "node scripts/golden-spatula-fetch-knowledge.mjs",
    "golden:enrich-augment-recommendations": "node scripts/golden-spatula-enrich-augment-recommendations.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,json}\" \"scripts/**/*.{js,mjs,cjs,json,md}\" \"projects/**/*.{json,md}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,json}\" \"scripts/**/*.{js,mjs,cjs,json,md}\" \"projects/**/*.{json,md}\" \"*.{json,md}\"",
    "format:rust": "cd src-tauri && cargo fmt",
    "format:all": "pnpm format && pnpm format:rust",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "driver.js": "^1.4.0",
    "i18next": "^25.7.4",
    "jsonc-parser": "^3.3.1",
    "loglevel": "^1.9.2",
    "lucide-react": "^0.562.0",
    "marked": "^17.0.1",
    "react": "^19.1.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.3",
    "semver": "^7.7.3",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^4.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx,css,json}": "prettier --write",
    "*.{json,md}": "prettier --write",
    "src-tauri/src/**/*.rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --"
  }
}
